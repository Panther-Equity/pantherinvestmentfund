# Supabase — from Supabase Dashboard > Settings > API
# These two are safe in the browser (they are "public").
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SECRET — server only, never commit, never expose to the browser.
# Settings > API > Project API keys > service_role (click "reveal").
# Required for the People / invite flow.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public base URL of the deployment, no trailing slash.
# Used by app/api/invite to build the invite link that goes out to members.
# Optional: falls back to the request origin when unset, which is correct for
# local dev. Set it in Vercel so invite links point at the live site rather
# than whichever preview deployment happened to serve the request.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
